{
	"name": "convergence",
	"version": "0.0.1",
	"description": "Convergence: an AI composes a declarative recon dataflow; a deterministic engine runs it to a fixpoint.",
	"license": "UNLICENSED",
	"private": true,
	"scripts": {
		"web": "forever src",
		"watch": "nodemon src",
		"flow": "node bin/run.js",
		"flow-watch": "nodemon bin/run.js",
		"monitor": "forever bin/monitor.js",
		"monitor-watch": "nodemon bin/monitor.js",
		"playbooks": "forever bin/monitor.js --playbooks",
		"playbooks-watch": "nodemon bin/monitor.js --playbooks",
		"export": "node bin/export.js",
		"mcp": "node bin/mcp.mjs",
		"frontend:verify": "node frontend/__tests__/verify.mjs",
		"frontend:build": "node bin/build-frontend.js",
		"lint": "eslint src/ bin/ frontend/ *.config.js",
		"test": "jest",
		"test:watch": "jest --watch",
		"prepare": "husky"
	},
	"jest": {
		"testEnvironment": "node",
		"forceExit": true,
		"roots": [
			"src"
		],
		"transformIgnorePatterns": [
			"/node_modules/(?!(uuid|sift)/)"
		]
	},
	"lint-staged": {
		"*.js": "eslint --fix"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"browserslist": "^4.28.7",
		"express": "^5.2.1",
		"geolib": "^3.3.14",
		"got-verbose": "^0.0.18",
		"ioredis": "^6.0.0",
		"ip": "^2.0.1",
		"ip-address": "^10.4.0",
		"ipaddr.js": "^2.5.0",
		"js-yaml": "^5.2.3",
		"mongodb": "^7.5.0",
		"node-cron": "^4.6.0",
		"queue-promised": "^0.0.30",
		"random-useragent": "^0.5.0",
		"read-tls-client-hello": "^2.0.0",
		"sift": "^17.1.3",
		"top-user-agents": "^2.1.127",
		"ua-parser-js": "^2.0.10",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/core": "^8.0.1",
		"@babel/eslint-parser": "^8.0.1",
		"@babel/preset-env": "^8.0.2",
		"@eslint/js": "^10.0.1",
		"@happy-dom/global-registrator": "^20.11.1",
		"@nemanjan00/qrp": "^0.9.1",
		"babel-jest": "^30.4.1",
		"eslint": "^10.8.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"lint-staged": "^17.3.0",
		"mongodb-memory-server": "^11.2.0",
		"nodemon": "^3.1.14",
		"supertest": "^7.2.2"
	}
}
