{
	"name": "recon-flow",
	"version": "0.0.1",
	"description": "Repeatable agentic recon: an AI composes the dataflow, a deterministic runtime executes it.",
	"license": "UNLICENSED",
	"private": true,
	"scripts": {
		"web": "forever src",
		"watch": "nodemon src",
		"demo": "node bin/demo.js",
		"demo-watch": "nodemon bin/demo.js",
		"flow": "node bin/run.js",
		"flow-watch": "nodemon bin/run.js",
		"lint": "eslint src/ bin/",
		"test": "jest",
		"test:watch": "jest --watch",
		"prepare": "husky"
	},
	"jest": {
		"testEnvironment": "node",
		"forceExit": true,
		"transformIgnorePatterns": [
			"/node_modules/(?!(uuid|sift)/)"
		]
	},
	"lint-staged": {
		"*.js": "eslint --fix"
	},
	"dependencies": {
		"browserslist": "^4.28.7",
		"geolib": "^3.3.14",
		"got-verbose": "^0.0.18",
		"ioredis": "^6.0.0",
		"ip": "^2.0.1",
		"ip-address": "^10.4.0",
		"ipaddr.js": "^2.5.0",
		"js-yaml": "^5.2.3",
		"queue-promised": "^0.0.30",
		"random-useragent": "^0.5.0",
		"sift": "^17.1.3",
		"top-user-agents": "^2.1.127",
		"ua-parser-js": "^2.0.10",
		"uuid": "^14.0.1"
	},
	"devDependencies": {
		"@babel/core": "^8.0.1",
		"@babel/eslint-parser": "^8.0.1",
		"@babel/preset-env": "^8.0.2",
		"@eslint/js": "^10.0.1",
		"babel-jest": "^30.4.1",
		"eslint": "^10.8.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"lint-staged": "^17.3.0",
		"nodemon": "^3.1.14"
	}
}
